<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="nightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0c0a1d;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1235;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0c0a1d;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="lightGlow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" style="stop-color:#f59e0b;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#nightGrad)"/>
  
  <!-- Stage glow -->
  <ellipse cx="300" cy="250" rx="250" ry="80" fill="url(#lightGlow)"/>
  
  <!-- Stage -->
  <rect x="100" y="280" width="400" height="15" fill="#7c3aed" rx="2"/>
  <polygon points="80,295 520,295 500,310 100,310" fill="#6d28d9"/>
  
  <!-- Microphone stand -->
  <line x1="300" y1="280" x2="300" y2="180" stroke="#94a3b8" stroke-width="3"/>
  <circle cx="300" cy="280" r="8" fill="#64748b"/>
  
  <!-- Microphone -->
  <ellipse cx="300" cy="165" rx="15" ry="20" fill="#cbd5e1"/>
  <rect x="290" y="165" width="20" height="10" fill="#94a3b8"/>
  <path d="M 300 175 L 300 180" stroke="#64748b" stroke-width="3"/>
  
  <!-- Musical notes -->
  <g fill="#fbbf24">
    <circle cx="200" cy="120" r="8"/>
    <rect x="207" y="85" width="3" height="35"/>
    <circle cx="210" cy="85" r="6"/>
    
    <circle cx="400" cy="140" r="8"/>
    <rect x="407" y="100" width="3" height="40"/>
    <circle cx="410" cy="100" r="6"/>
    
    <circle cx="150" cy="180" r="6"/>
    <rect x="156" y="155" width="2" height="25"/>
    
    <circle cx="450" cy="200" r="6"/>
    <rect x="456" y="175" width="2" height="25"/>
  </g>
  
  <!-- Spotlight effects -->
  <path d="M 200 50 L 180 280 L 220 280 Z" fill="#fbbf24" opacity="0.1"/>
  <path d="M 400 50 L 380 280 L 420 280 Z" fill="#fbbf24" opacity="0.1"/>
  
  <!-- Decorative stars -->
  <circle cx="120" cy="80" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="480" cy="100" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="250" cy="60" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="350" cy="70" r="2" fill="#ffffff" opacity="0.8"/>
  
  <!-- Text -->
  <text x="300" y="340" font-family="'Playfair Display', serif" font-size="36" 
        font-weight="bold" fill="#fbbf24" text-anchor="middle">
    FOSLA Club
  </text>
  <text x="300" y="370" font-family="Arial, sans-serif" font-size="18" 
        fill="#c4b5fd" text-anchor="middle">
    Theme Song Launch
  </text>
</svg>

<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a0530;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#2d1b4e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a0530;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#7c3aed;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#bgGrad)"/>
  
  <!-- Glow effects -->
  <circle cx="150" cy="200" r="150" fill="url(#glow)" opacity="0.3"/>
  <circle cx="450" cy="200" r="150" fill="url(#glow)" opacity="0.3"/>
  
  <!-- Decorative circles -->
  <circle cx="100" cy="80" r="30" fill="#7c3aed" opacity="0.2"/>
  <circle cx="500" cy="320" r="40" fill="#a78bfa" opacity="0.2"/>
  <circle cx="300" cy="350" r="25" fill="#c4b5fd" opacity="0.3"/>
  
  <!-- Main Icon (Rocket/Launch) -->
  <g transform="translate(250, 100)">
    <!-- Rocket body -->
    <path d="M 50 150 L 50 80 Q 50 30 80 20 Q 100 15 100 20 L 100 150 Z" 
          fill="#7c3aed" stroke="#a78bfa" stroke-width="2"/>
    
    <!-- Rocket window -->
    <circle cx="75" cy="70" r="15" fill="#c4b5fd" opacity="0.8"/>
    
    <!-- Rocket fins -->
    <path d="M 50 120 L 30 150 L 50 140 Z" fill="#6d28d9"/>
    <path d="M 100 120 L 120 150 L 100 140 Z" fill="#6d28d9"/>
    
    <!-- Rocket flame -->
    <path d="M 60 150 Q 75 170 75 185 Q 75 170 90 150 Z" 
          fill="#fbbf24" opacity="0.9"/>
    <path d="M 65 155 Q 75 165 75 175 Q 75 165 85 155 Z" 
          fill="#f59e0b" opacity="0.9"/>
  </g>
  
  <!-- Text -->
  <text x="300" y="320" font-family="'Playfair Display', serif" font-size="32" 
        font-weight="bold" fill="#ffffff" text-anchor="middle">
    Mission Elizian
  </text>
  <text x="300" y="350" font-family="Arial, sans-serif" font-size="18" 
        fill="#c4b5fd" text-anchor="middle">
    Launch Event
  </text>
  
  <!-- Sparkle effects -->
  <circle cx="200" cy="140" r="3" fill="#fbbf24"/>
  <circle cx="380" cy="160" r="2" fill="#ffffff"/>
  <circle cx="150" cy="200" r="2" fill="#c4b5fd"/>
  <circle cx="420" cy="220" r="3" fill="#fbbf24"/>
</svg>

# ============================================
# ELIZIAN BACKEND ENVIRONMENT CONFIGURATION
# ============================================

# Environment (REQUIRED)
# Options: development, production, test
NODE_ENV=development

# Database Configuration (REQUIRED)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=elizian
DB_PASSWORD=your_secure_db_password
DB_PORT=5432

# JWT Configuration (REQUIRED)
# Generate a strong secret: node generate-jwt-secret.js
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# Server Configuration
PORT=5001

# CORS Configuration (REQUIRED for production)
# Add your production frontend URLs here
# FRONTEND_URL=https://yourdomain.com
# ADMIN_URL=https://admin.yourdomain.com

# Optional: Additional Configuration
# LOG_LEVEL=info
# LOG_OTP=true (set to false to disable OTP logging even in development)
# API_RATE_LIMIT=100
# OTP_RATE_LIMIT=3
EMAIL_USER=teamelizian@gmail.com
EMAIL_PASS=ymiionilaebsbtbw

# Real-time WebSocket
ENABLE_WEBSOCKET=true

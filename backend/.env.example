# Railway Production Environment
DATABASE_URL=
# Backend port. Frontend VITE_API_BASE_URL must match (default frontend uses 4000).
PORT=4000
NODE_ENV=production

# Local Development (alternative to DATABASE_URL)
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=elizian
# DB_PASSWORD=your_secure_db_password
# DB_PORT=5432

MASTER_PRIVATE_KEY=0x5517fd7320e080fab8d39f1480feac1d77133f2a667df9653aa54b5c2b49d1fe

# Required
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# Optional – Geo (Part A): server-side geocoding when partner address is saved. If unset, address saves but geo_verified stays false.
# GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key

# Optional – Dual confirmation: when true, partner redeems → customer must confirm in app. When false or unset, partner redeem completes immediately (no customer confirm).
# Set to false to avoid "pending_confirmation" and customer confirm step.
# DUAL_CONFIRMATION_ENABLED=false
# Optional – When dual confirmation is on, require customer to check in at venue before partner can redeem. Default: not set = redemption allowed without check-in. Set to true to enforce check-in.
# REQUIRE_VISIT_SESSION_FOR_REDEMPTION=true

# Optional – API rate limit (requests per 15 min). Default 100 in production, 2000 in development.
# RATE_LIMIT_MAX=100
# Set to 1 to disable API rate limiting (avoids "Too many requests" / 429 during local dev).
RATE_LIMIT_DISABLED=1

# Optional
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080/admin.html
EMAIL_USER=teamelizian@gmail.com
EMAIL_PASS=your_email_password_here
LOG_OTP=true

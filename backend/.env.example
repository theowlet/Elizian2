# Railway Production Environment
DATABASE_URL=
# Backend port. Frontend VITE_API_BASE_URL must match (e.g. http://localhost:3000).
PORT=3000
NODE_ENV=production

# Local Development (alternative to DATABASE_URL)
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=elizian
# DB_PASSWORD=your_secure_db_password
# DB_PORT=5432

MASTER_PRIVATE_KEY=0x5517fd7320e080fab8d39f1480feac1d77133f2a667df9653aa54b5c2b49d1fe

# Required
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# Optional – Geo (Part A): server-side geocoding when partner address is saved. If unset, address saves but geo_verified stays false.
# GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key

# Optional – Dual confirmation (redemption overhaul). When true, redemption goes to pending_confirmation until customer confirms.
# DUAL_CONFIRMATION_ENABLED=false

# Optional – API rate limit (requests per 15 min). Default 100 in production, 2000 in development.
# RATE_LIMIT_MAX=100
# Set to 1 to disable API rate limiting (avoids "Too many requests" / 429 during local dev).
RATE_LIMIT_DISABLED=1

# Optional
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080/admin.html
EMAIL_USER=teamelizian@gmail.com
EMAIL_PASS=your_email_password_here
LOG_OTP=true

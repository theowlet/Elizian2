# 🌐 Server Configuration
NODE_ENV=development
PORT=5001

# 🗄️ Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elizian
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD_HERE   # Leave as placeholder

# 🔐 JWT and Security
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:8080

# 📱 Frontend & Admin URLs
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080/admin.html

# 📲 OTP and SMS Service (optional placeholders)
OTP_EXPIRY_MINUTES=5
LOG_OTP=true
SMS_PROVIDER_API_KEY=your_sms_api_key_here

# 📩 Email Service (optional)
EMAIL_SERVICE_PROVIDER=gmail
EMAIL_USER=youremail@example.com
EMAIL_PASS=your_email_password_here